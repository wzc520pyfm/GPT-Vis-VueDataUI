{
  "name": "gptvis-vue-data-ui",
  "version": "0.1.0",
  "description": "VueDataUI adapter for GPT-Vis. Same vis syntax, GPTVis class and chart constructors, rendered with Vue Data UI.",
  "keywords": [
    "gpt-vis",
    "vue-data-ui",
    "vue",
    "vis",
    "llm",
    "charts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/GPT-Vis-VueDataUI.git",
    "directory": "packages/gptvis-vue-data-ui"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/runtime.js",
    "./dist/vue.js"
  ],
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run && npm run build && node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "vue-data-ui": ">=3.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-data-ui": "^3.28.12"
  }
}

